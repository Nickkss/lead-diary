# Copy to .env (install.sh does this for you). Restart after changes:  docker compose up -d
DOMAIN=leads.example.com
PUBLIC_URL=https://leads.example.com
TZ=Asia/Kolkata

# AI (optional): https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Google Calendar (optional): see README -> Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How HTTPS is handled: caddy (built in), nginx (existing nginx on the server) or manual
PROXY_MODE=caddy
APP_PORT=3010
